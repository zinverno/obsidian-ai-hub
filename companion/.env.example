HOST=127.0.0.1
PORT=27124
COMPANION_TOKEN=replace-with-a-long-random-secret
DATA_DIR=./data
ALLOW_REMOTE_BIND=false
LOG_LEVEL=info

# Optional read-only MCP endpoint. Never reuse COMPANION_TOKEN here.
MCP_ENABLED=false
MCP_TOKEN=
MCP_VAULT_ID=
MCP_EMBEDDING_API_KEY=
MCP_EMBEDDING_TIMEOUT_MS=30000
# Add the reverse proxy's public hostname for remote deployments.
MCP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
